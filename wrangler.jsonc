{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "purdue-ieee-website",
  "main": "src/worker.ts",
  "compatibility_date": "2026-04-28",
  "routes": [
    {
      "pattern": "purdueieee.org",
      "custom_domain": true
    },
    {
      "pattern": "www.purdueieee.org",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "VITE_SANITY_PROJECT_ID": "vq0v7yv4",
    "VITE_SANITY_DATASET": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "boilerbooks",
      "database_id": "fa0def27-5b45-4028-b8e3-b3d0b6f80b95",
      "migrations_dir": "migrations",
      "remote": true
    }
  ]
}
